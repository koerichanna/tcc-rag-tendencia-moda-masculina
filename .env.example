# --- Desenvolvimento local (.env) ---
DATABASE_URL=postgresql://postgres:admin@localhost:5432/moda_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=moda_db

GOOGLE_API_KEY=sua_chave_gemini_aqui
OPENAI_API_KEY=

# Segredo que assina os tokens de login (obrigatório em produção/homologação).
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

CHROMA_PERSIST_DIRECTORY=./data/chroma_db
ENVIRONMENT=development

# Opcional: banco usado pelos testes (padrão: mesmo servidor, banco moda_test)
# TEST_DATABASE_URL=postgresql://postgres:admin@localhost:5432/moda_test
